[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=all/all;inode/directory;application/zip;application/x-7z-compressed;application/vnd.rar;application/x-rar-compressed;application/x-tar;application/gzip;application/x-compressed-tar;application/x-xz;application/x-xz-compressed-tar;application/zstd;application/x-zmanager-tzst;application/x-zmanager-tzap;
Actions=Compress;Extract;
X-KDE-Priority=TopLevel
X-KDE-Submenu=ZManager

[Desktop Action Compress]
Name=Compress using ZManager
Icon=zmanager-desktop
Exec=zmanager-desktop --quick-action compress --path %F

[Desktop Action Extract]
Name=Extract using ZManager
Icon=zmanager-desktop
Exec=zmanager-desktop --quick-action extract --path %F
