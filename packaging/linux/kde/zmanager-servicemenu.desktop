[Desktop Entry]
Type=Service
Name=ZManager
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=application/octet-stream;inode/directory;
Actions=AddToArchive;AddToTzap;AddToZip;AddToSevenZ;AddToTzst;AddToTgz;CompressShareOnLan;ShareOnLan;
X-KDE-Priority=TopLevel
X-KDE-Submenu=ZManager

[Desktop Action AddToArchive]
Name=Add to archive...
Icon=zmanager-desktop
Exec=zmanager-desktop --quick-action compress --path %F

[Desktop Action AddToTzap]
Name=Add to .tzap
Icon=zmanager-desktop
Exec=zmanager-desktop --quick-action compress-tzap --path %F

[Desktop Action AddToZip]
Name=Add to .zip
Icon=zmanager-desktop
Exec=zmanager-desktop --quick-action compress-zip --path %F

[Desktop Action AddToSevenZ]
Name=Add to .7z
Icon=zmanager-desktop
Exec=zmanager-desktop --quick-action compress-7z --path %F

[Desktop Action AddToTzst]
Name=Add to .tzst
Icon=zmanager-desktop
Exec=zmanager-desktop --quick-action compress-tzst --path %F

[Desktop Action AddToTgz]
Name=Add to .tgz
Icon=zmanager-desktop
Exec=zmanager-desktop --quick-action compress-tgz --path %F

[Desktop Action CompressShareOnLan]
Name=Compress and Share on LAN
Icon=zmanager-desktop
Exec=zmanager-desktop --quick-action compress-share-on-lan --path %F

[Desktop Action ShareOnLan]
Name=Share on LAN
Icon=zmanager-desktop
Exec=zmanager-desktop --quick-action share-lan --path %f
