{
  "name": "zmanager-desktop",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run generate:archive-types && tsc --noEmit && vite build",
    "generate:archive-types": "node scripts/generate-archive-file-types.mjs",
    "preview": "vite preview",
    "test:frontend": "vitest run",
    "test:e2e": "playwright test",
