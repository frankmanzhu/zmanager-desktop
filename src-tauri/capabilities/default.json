{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Allow the main ZManager window to run archive commands and use native file dialogs/openers.",
  "windows": ["main"],
  "platforms": ["windows", "linux"],
  "permissions": [
    "allow-healthcheck",
    "allow-project-contract",
    "allow-system-file-icons",
    "allow-quick-action-startup-state",
    "allow-list-archive",
    "allow-plan-create",
    "allow-start-create",
    "allow-start-extract",
    "allow-verify-tzap-certificate",
    "allow-generate-tzap-identity",
    "allow-start-native-file-drag",
    "allow-preview-entry",
    "allow-cleanup-preview-roots",
    "allow-test-archive",
    "allow-subscribe-job",
    "allow-subscribe-job-catalog",
    "allow-ack-subscription",
    "allow-unsubscribe-job",
    "allow-cancel-job",
    "allow-pause-job",
    "allow-resume-job",
    "allow-dismiss-job",
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-create",
    "core:window:allow-center",
    "core:window:allow-close",
    "core:window:allow-inner-position",
    "core:window:allow-inner-size",
    "core:window:allow-hide",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-set-min-size",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-unminimize",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$TEMP/zmanager-preview-*/**" },
        { "path": "$TEMP/zmanager-preview-windows-*/**" }
      ]
    }
  ]
}
