{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Allow the main ZManager window to run archive commands and use native file dialogs/openers.",
  "windows": ["main"],
  "platforms": ["windows", "linux"],
  "permissions": [
    "allow-healthcheck",
    "allow-project-contract",
    "allow-system-file-icons",
    "allow-quick-action-startup-state",
    "allow-list-archive",
    "allow-plan-create",
    "allow-start-create",
    "allow-start-extract",
    "allow-start-native-file-drag",
    "allow-prepare-native-file-drag",
    "allow-clear-native-file-drag",
    "allow-preview-entry",
    "allow-cleanup-preview-roots",
    "allow-test-archive",
    "allow-poll-job-events",
    "allow-cancel-job",
    "allow-dismiss-job",
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$TEMP/zmanager-preview-*/**" },
        { "path": "$TEMP/zmanager-preview-windows-*/**" }
      ]
    }
  ]
}
